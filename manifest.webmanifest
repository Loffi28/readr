{
  "name": "Readr — читалка с переводом",
  "short_name": "Readr",
  "description": "Читайте на иностранном языке: перевод слов в один клик, личный словарь и карточки.",
  "lang": "ru",
  "start_url": "./#/library",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F6F1E9",
  "theme_color": "#F6F1E9",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./#/library",
      "accept": {
        "application/pdf": [".pdf"],
        "application/epub+zip": [".epub"],
        "text/plain": [".txt", ".srt", ".vtt", ".md"]
      }
    }
  ]
}
